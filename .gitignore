# Local self-hosted runtime data
data/
.run/

# Production secrets
.env.production
Frontend/.env.production

# Python venv (native deploy)
Backend/.venv/

# Cloudflare tunnel (generated by self-deploy.sh)
deploy/cloudflare/cf-state/
deploy/cloudflare/config.yml
deploy/cloudflare/cloudflared.exe

# Nested app ignores (after submodule flatten)
Ecommerce (2)/Frontend/node_modules/
Ecommerce (2)/Frontend/.next/
Ecommerce (2)/Frontend/.env
Ecommerce (2)/Frontend/.env.*
Ecommerce (2)/Backend/.venv/
Ecommerce (2)/Backend/__pycache__/
Ecommerce (2)/Backend/**/__pycache__/
Ecommerce (2)/Backend/*.lnk
Ecommerce (2)/deploy/cloudflare/cf-state/

# Generated / local-only
**/__pycache__/
**/*.pyc
**/*.lnk
Backend/upload_jobs/*.csv
Backend/upload_jobs/*.json

# Runtime uploads on Render (do not re-ship deleted datasets via git)
Backend/datasets/*
!Backend/datasets/registry.json
!Backend/datasets/baseline-500k.csv
Backend/models/*
!Backend/models/baseline-500k/

.deploy-secrets.local.json

Backend/daraz_multicategory_pakistan_200k.csv
Backend/daraz_multicategory_pakistan_300k.csv
