# Vercel (Frontend) + Render (ML Backend) split
#
# Copy values into:
# - Vercel Project → Settings → Environment Variables
# - Render Web Service → Environment
# Do NOT commit real secrets.

# --- Vercel (Frontend / Next.js) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ep?sslmode=require
DATABASE_SSL=true
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Public URL of the Render ML service (no trailing slash)
BACKEND_API_URL=https://ecommerce-ml-api.onrender.com

# Shared secret — must match Render BACKEND_API_KEY
BACKEND_API_KEY=generate_a_long_random_string

# --- Render (Python FastAPI in Backend/) ---
# BACKEND_API_KEY=<same as above>
# PYTHON_VERSION=3.11.9
