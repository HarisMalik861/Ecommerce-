# Copy to .env.production on the droplet and fill in secrets.
# cp .env.production.example .env.production

# Postgres container hostname on the shared Docker network
DATABASE_URL=postgresql://postgres:umerfarooq@postgres:5432/ep
DATABASE_SSL=false

# Generate on droplet: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

JWT_EXPIRES_IN=7d
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
