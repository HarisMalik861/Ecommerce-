# Generated by self-deploy.sh after `cloudflared tunnel login` + `tunnel create`.
# Copy is not needed — self-deploy writes deploy/cloudflare/config.yml automatically.

tunnel: YOUR_TUNNEL_ID
credentials-file: /etc/cloudflared/YOUR_TUNNEL_ID.json

ingress:
  - hostname: trendinsight.live
    service: http://localhost:4001
  - hostname: www.trendinsight.live
    service: http://localhost:4001
  - service: http_status:404
