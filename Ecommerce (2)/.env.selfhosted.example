# Copy to .env.production and fill in secrets:
#   cp .env.selfhosted.example .env.production   (Git Bash)
#   copy .env.selfhosted.example .env.production (PowerShell)
#
# Native self-host (no Docker): PostgreSQL must run locally on port 5432.

DATABASE_URL=postgresql://postgres:umerfarooq@localhost:5432/ep
DATABASE_SSL=false

# Generate: openssl rand -hex 32  (or leave placeholder — self-deploy.sh auto-fills)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

JWT_EXPIRES_IN=7d
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Cloudflare Tunnel — leave token empty to use `cloudflared tunnel login` (recommended)
CLOUDFLARE_TUNNEL_TOKEN=

# Tunnel name for `cloudflared tunnel create`
CLOUDFLARE_TUNNEL_NAME=trendinsight-ecommerce
